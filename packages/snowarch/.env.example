# @farstic/snowarch — environment contract
#
# Every key here is read by src/. Every key src/ reads is here, or on the allow-list in
# tests/docs/env-example.test.ts. That test enforces both directions, because the failure this
# file guards against is a documented variable that does nothing — the 1.x documentation named
# several authentication and configuration switches that were never implemented. The CHANGELOG
# lists them; naming them here would trip the CI grep that keeps them out.
#
# Copy to .env and point SNOW_ENV_FILE at it. The server never reads the current directory's
# .env: for an MCP server that directory is your project, and an unrelated WRITE_ENABLED=true
# sitting there would arm writes nobody chose.

# ─── Where configuration comes from ──────────────────────────────────────────

# An explicit store path. A missing file here is an ERROR, not a fallback.
SNOW_STORE=

# The .env file to load. Unset means load none.
SNOW_ENV_FILE=

# error | warn | info | debug. Default info. LOG_LEVEL is still read as a fallback.
SNOW_LOG_LEVEL=info

# ─── An instance defined by environment ──────────────────────────────────────
#
# These define ONE instance and win over any store, which is then reported as ignored at
# start-up. Use the store for more than one instance.

SERVICENOW_INSTANCE_URL=https://dev12345.service-now.com
SERVICENOW_AUTH_METHOD=basic

# basic
SERVICENOW_BASIC_USERNAME=
SERVICENOW_BASIC_PASSWORD=

# oauth (resource-owner password credentials)
SERVICENOW_OAUTH_CLIENT_ID=
SERVICENOW_OAUTH_CLIENT_SECRET=
SERVICENOW_OAUTH_USERNAME=
SERVICENOW_OAUTH_PASSWORD=

# ─── The six gates ───────────────────────────────────────────────────────────
#
# A flag is on only when it is the exact string "true". TRUE, 1, yes and unset are all off.
# CMDB_WRITE, SCRIPTING, ATF and NOW_ASSIST additionally require WRITE.
# Prefer `preset` in the store; these exist for an env-defined instance.

WRITE_ENABLED=false
CMDB_WRITE_ENABLED=false
SCRIPTING_ENABLED=false
ATF_ENABLED=false
NOW_ASSIST_ENABLED=false
FLUENT_ENABLED=false

# A legacy alias, read BEFORE SERVICENOW_BASIC_USERNAME when the server needs to know whose
# tasks and approvals "mine" refers to. Set the basic username instead; this exists so a 1.x
# environment keeps working. Documented because it changes behaviour — an undocumented switch
# that does is worse than a documented one that does not.
SERVICENOW_USERNAME=

# ─── Behaviour ───────────────────────────────────────────────────────────────

# full, or a role bundle. Must be full for the Architect: a bundle hides tools the engine cites.
MCP_TOOL_PACKAGE=full

# Default page size when a call passes no limit. Capped at 1000. Default 100.
MAX_RECORDS=100

# Retry and timeout for one request. 0 is a real value for both — the client uses `??`, not `||`.
MAX_RETRIES=3
RETRY_DELAY_MS=1000
REQUEST_TIMEOUT_MS=30000

# The table prefix the agile tools use. Default rm_ — change it only on an instance where the
# agile tables were created under another prefix. Read once, at module load.
AGILE_TABLE_PREFIX=rm_

# The ceiling on one tool result, in characters. Default 100000. A client's
# _meta["anthropic/maxResultSizeChars"] wins over this.
SNOW_MAX_RESULT_CHARS=100000

# ─── Audit and redaction ─────────────────────────────────────────────────────

# Where the audit trail is written. `off` disables it, warned once at start-up.
SNOW_AUDIT_FILE=

# Redaction is ON unless this is exactly "false". Turning it off prints passwords and
# Authorization headers to stderr — for local debugging only, and dangerous by design.
REDACT_SENSITIVE_DATA=true

# ─── Typing a password ───────────────────────────────────────────────────────
#
# `snowarch instance add` echoes NOTHING while a password is typed. Set this to `asterisk` for
# one star per character if you need the feedback — it reveals the LENGTH of the password to
# anyone watching the screen, which is why it is not the default. Any other value is ignored.
SNOWARCH_MASK=

# ─── Corporate networks ──────────────────────────────────────────────────────
#
# Read by the HTTP agent and by Node itself. An empty value means unset — the server deletes
# empty ones at start-up, so a launcher that forwards ${HTTPS_PROXY:-} is safe.
#
#   HTTPS_PROXY / HTTP_PROXY / NO_PROXY   (and their lowercase forms)
#   NODE_EXTRA_CA_CERTS                   read by Node at process start; restart to change it
